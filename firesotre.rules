rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the email(s) you use to sign in to CJ-Orders.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["chanchan.tumulak@gmail.com"];
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Adjust "orders" if your collection has a different name.
    match /orders/{orderId} {
      // Only verified customers can place an order, and only under their own uid.
      // This assumes each order document stores the customer's uid in a "uid" field.
      allow create: if isVerified()
                    && request.resource.data.uid == request.auth.uid;

      // Customers can read their own orders; admin can read all.
      allow read: if isAdmin()
                  || (isVerified() && resource.data.uid == request.auth.uid);

      // Only admin can change order status or delete.
      allow update, delete: if isAdmin();
    }
  }
}
